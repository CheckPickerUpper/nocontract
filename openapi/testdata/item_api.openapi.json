{
  "openapi": "3.1.0",
  "info": {
    "title": "ItemApi",
    "version": "2.1.0"
  },
  "tags": [
    {
      "name": "items"
    }
  ],
  "paths": {
    "/items": {
      "post": {
        "tags": [
          "items"
        ],
        "operationId": "items.addItem",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "item": {
                    "$ref": "#/components/schemas/Item"
                  }
                },
                "required": [
                  "item"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemAdded"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            }
          }
        }
      }
    },
    "/items/{item_id}": {
      "delete": {
        "tags": [
          "items"
        ],
        "operationId": "items.removeItem",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uint64",
              "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemRemoved"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemMissing"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "items"
        ],
        "operationId": "items.readItem",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uint64",
              "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "name",
                "price"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemRead"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ItemMissing"
                    },
                    {
                      "$ref": "#/components/schemas/ShopClosed"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "_tag",
                    "mapping": {
                      "ItemMissing": "#/components/schemas/ItemMissing",
                      "ShopClosed": "#/components/schemas/ShopClosed"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "properties": {
          "added": {
            "type": "string",
            "format": "date-time"
          },
          "box": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            },
            "required": [
              "width"
            ],
            "additionalProperties": false
          },
          "corners": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "count": {
            "type": "integer",
            "format": "int32",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "discount": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Price"
              },
              {
                "type": "null"
              }
            ]
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "name": {
            "type": "string"
          },
          "prices": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "size": {
            "type": "string",
            "enum": [
              "small",
              "large"
            ]
          },
          "sold": {
            "type": "boolean"
          },
          "stock": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "north",
                "south"
              ]
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "weight": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "count",
          "weight",
          "sold",
          "added",
          "size",
          "labels",
          "corners",
          "prices",
          "stock",
          "discount",
          "box"
        ],
        "additionalProperties": false
      },
      "ItemAdded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "ItemAdded"
            ]
          },
          "id": {
            "type": "string",
            "format": "int64",
            "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7]|-(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-8]))$"
          }
        },
        "required": [
          "_tag",
          "id"
        ],
        "additionalProperties": false
      },
      "ItemMissing": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "ItemMissing"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "IT-1001"
            ]
          },
          "item_id": {
            "type": "string",
            "format": "uint64",
            "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
          }
        },
        "required": [
          "_tag",
          "code",
          "item_id"
        ],
        "additionalProperties": false
      },
      "ItemRead": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "ItemRead"
            ]
          },
          "item": {
            "$ref": "#/components/schemas/Item"
          }
        },
        "required": [
          "_tag",
          "item"
        ],
        "additionalProperties": false
      },
      "ItemRemoved": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "ItemRemoved"
            ]
          }
        },
        "required": [
          "_tag"
        ],
        "additionalProperties": false
      },
      "Price": {
        "type": "object",
        "properties": {
          "cents": {
            "type": "integer",
            "minimum": -128,
            "maximum": 127
          }
        },
        "required": [
          "cents"
        ],
        "additionalProperties": false
      },
      "RequestRefused": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "RequestRefused"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "NC-1001"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "_tag",
          "code",
          "reason"
        ],
        "additionalProperties": false
      },
      "ShopClosed": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "ShopClosed"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "IT-1002"
            ]
          },
          "reopens": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "_tag",
          "code",
          "reopens"
        ],
        "additionalProperties": false
      }
    }
  }
}
